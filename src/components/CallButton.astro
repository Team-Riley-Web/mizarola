---
import { Phone } from '@lucide/astro';

const phoneDisplay = '095 534 7103';
const phoneHref = 'tel:+385955347103';
---

<a
  href={phoneHref}
  class="fixed inset-x-0 bottom-0 z-50 flex items-center justify-center gap-2 bg-brick-600 py-3.5 text-sm font-semibold text-white shadow-[0_-4px_16px_rgba(0,0,0,0.2)] sm:hidden"
  style="padding-bottom: calc(0.875rem + env(safe-area-inset-bottom));"
>
  <Phone class="h-4 w-4" />
  Nazovite nas &middot; {phoneDisplay}
</a>
