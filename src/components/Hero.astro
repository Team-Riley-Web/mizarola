---
import { Image } from 'astro:assets';
import grill from '../assets/images/grill.webp';
import outside from '../assets/images/outside.webp';

const mapsHref =
  'https://www.google.com/maps/search/?api=1&query=' +
  encodeURIComponent('Konoba Mizarola, Riva 18, 21469 Sućuraj, Croatia');
---

<section id="top" class="relative isolate min-h-[100svh] overflow-hidden bg-sea-950">
  <Image
    src={grill}
    alt="Riba i povrće na žaru, otvorena vatra u Konobi Mizarola"
    class="absolute inset-0 hidden h-full w-full scale-[1.02] object-cover sm:block"
    widths={[768, 1200, 1800, 2400]}
    sizes="100vw"
    priority
  />
  <Image
    src={outside}
    alt="Konoba Mizarola, terasa i kamena fasada u Sućurju"
    class="absolute inset-0 h-full w-full scale-[1.02] object-cover sm:hidden"
    widths={[480, 768, 1080]}
    sizes="100vw"
    priority
  />

  <div class="absolute inset-0 bg-gradient-to-t from-sea-950/95 via-sea-950/55 to-sea-950/25 sm:bg-gradient-to-t sm:from-sea-950/90 sm:via-sea-950/45 sm:to-sea-950/20"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-sea-950/25 via-transparent to-sea-950/40"></div>

  <div class="relative z-10 grid min-h-[100svh] items-center px-5 pb-16 pt-32 sm:px-8 sm:pb-24 md:px-14">
    <div class="reveal is-visible mx-auto w-full max-w-3xl text-center">
      <p class="mb-4 text-lg font-normal tracking-[0.03em] text-amber-100/90">Sućuraj &middot; Otok Hvar &middot; Dalmacija</p>

      <h1 class="font-heading font-normal leading-[1.1] text-white text-[clamp(2.75rem,11vw,150px)]">
        Konoba Mizarola
      </h1>

      <p class="mx-auto max-w-xl text-lg leading-[1.5] tracking-[0.03em] text-white/90" x-show="$store.lang.current === 'hr'">
        Svježa riba, vatra s gradela i domaća kuhinja na rivi, u mjestu gdje se kamen spušta ravno u more.
      </p>
      <p class="mx-auto max-w-xl text-lg leading-[1.5] tracking-[0.03em] text-white/90" x-cloak x-show="$store.lang.current === 'en'">
        Fresh fish, grill, seafood and homestyle Dalmatian cooking by the harbour in Sućuraj.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href="#jelovnik"
          class="min-h-12 bg-brick-600 px-7 py-3 text-base font-semibold uppercase tracking-[0.03em] text-white shadow-lg shadow-brick-700/30 transition hover:-translate-y-0.5 hover:bg-brick-700"
        >
          <span x-show="$store.lang.current === 'hr'">Pogledajte jelovnik</span>
          <span x-cloak x-show="$store.lang.current === 'en'">View the menu</span>
        </a>
        <a
          href={mapsHref}
          target="_blank"
          rel="noopener noreferrer"
          class="min-h-12 border border-white/25 bg-white/10 px-7 py-3 text-base font-semibold uppercase tracking-[0.03em] text-white transition hover:-translate-y-0.5 hover:bg-white/15"
        >
          <span x-show="$store.lang.current === 'hr'">Kako do nas</span>
          <span x-cloak x-show="$store.lang.current === 'en'">Get directions</span>
        </a>
      </div>
    </div>
  </div>
</section>
