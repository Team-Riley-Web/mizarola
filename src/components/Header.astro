---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import LanguageToggle from './LanguageToggle.astro';
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-sea-950/90 backdrop-blur-md transition-colors duration-200"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 md:px-8">
    <a href="#top" class="flex shrink-0 items-center gap-3">
      <Image
        src={logo}
        alt="Konoba Mizarola logo"
        width={48}
        height={54}
        class="h-10 w-10 object-contain drop-shadow-lg md:h-11 md:w-11"
      />
      <span class="font-heading text-xl font-normal text-white lg:text-[33px]">Mizarola</span>
    </a>

    <nav class="hidden flex-1 items-center justify-center gap-6 text-lg font-semibold uppercase tracking-[0.03em] text-white/85 lg:flex xl:gap-8">
      <a href="#prica" class="hover:text-white">
        <span x-show="$store.lang.current === 'hr'">Priča</span>
        <span x-cloak x-show="$store.lang.current === 'en'">Story</span>
      </a>
      <a href="#jelovnik" class="hover:text-white">
        <span x-show="$store.lang.current === 'hr'">Jela</span>
        <span x-cloak x-show="$store.lang.current === 'en'">Dishes</span>
      </a>
      <a href="#kontakt" class="hover:text-white">
        <span x-show="$store.lang.current === 'hr'">Kontakt</span>
        <span x-cloak x-show="$store.lang.current === 'en'">Contact</span>
      </a>
    </nav>

    <div class="flex shrink-0 items-center gap-4">
      <a
        href="#jelovnik"
        class="hidden bg-brick-600 px-5 py-2.5 text-base font-semibold uppercase tracking-[0.03em] text-white transition hover:bg-brick-700 sm:inline-block"
      >
        <span x-show="$store.lang.current === 'hr'">Jelovnik</span>
        <span x-cloak x-show="$store.lang.current === 'en'">View Menu</span>
      </a>

      <LanguageToggle />
    </div>
  </div>
</header>
