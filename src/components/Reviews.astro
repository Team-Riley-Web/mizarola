---
import { ChevronLeft, ChevronRight, Star } from '@lucide/astro';
import { reviews } from '../data/reviews';
import donkeyPattern from '../assets/images/donkey-repeating-pattern.png';

const googleReviewsHref =
  'https://www.google.com/search?q=Konoba+Mizarola+Reviews';

const groupSize = 2;
const slides: (typeof reviews)[] = [];
for (let i = 0; i < reviews.length; i += groupSize) {
  const slide = reviews.slice(i, i + groupSize);
  if (slide.length < groupSize) slide.push(...reviews.slice(0, groupSize - slide.length));
  slides.push(slide);
}

const mobileSlides = [reviews[reviews.length - 1], ...reviews, reviews[0]];
const desktopSlides = [slides[slides.length - 1], ...slides, slides[0]];

const reviewTextClass = (text: string) => {
  if (text.length < 150) return 'text-[1.35rem] leading-[1.65] md:text-[1.2rem] lg:text-[1.32rem]';
  if (text.length < 300) return 'text-[1.08rem] leading-[1.72] md:text-[1.05rem] lg:text-[1.16rem]';
  return 'text-base leading-[1.7] md:text-[0.98rem] lg:text-[1.05rem]';
};

const reviewClass = (review: (typeof reviews)[number]) =>
  reviewTextClass(review.textHr.length > review.textEn.length ? review.textHr : review.textEn);
---

<section
  id="recenzije"
  class="relative scroll-mt-20 overflow-hidden bg-white py-20 md:py-28"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[image:var(--reviews-pattern)] bg-[length:420px_auto] bg-repeat opacity-[0.03] md:bg-[length:560px_auto]"
    style={`--reviews-pattern: url(${donkeyPattern.src});`}
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-7xl px-6 md:px-8">
    <div class="reveal mx-auto max-w-2xl text-center" x-intersect.once="$el.classList.add('is-visible')">
      <p class="text-lg font-normal tracking-[0.03em] text-brick-600">Recenzije &middot; Reviews</p>
      <h2 class="font-heading capitalize text-4xl font-normal text-sea-900 text-[clamp(2.5rem,5vw,4rem)]">
        <span x-show="$store.lang.current === 'hr'">Što kažu naši gosti</span>
        <span x-cloak x-show="$store.lang.current === 'en'">What our guests say</span>
      </h2>
      <a
        href={googleReviewsHref}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-flex flex-wrap items-center justify-center gap-3 text-base font-semibold text-sea-800 transition hover:text-brick-600"
      >
        <svg class="h-7 w-7 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82z" />
          <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09C3.26 21.3 7.31 24 12 24z" />
          <path fill="#FBBC05" d="M5.27 14.29c-.25-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29V6.62H1.29C.47 8.24 0 10.06 0 12s.47 3.76 1.29 5.38l3.98-3.09z" />
          <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.62l3.98 3.09C6.22 6.86 8.87 4.75 12 4.75z" />
        </svg>
        <span class="flex gap-1" aria-label="Pet od pet zvjezdica">
          {Array.from({ length: 5 }).map(() => (
            <Star class="h-4 w-4 text-[#f4b43f]" fill="currentColor" />
          ))}
        </span>
        <span class="underline decoration-brick-600 decoration-2 underline-offset-4" x-show="$store.lang.current === 'hr'">Pročitajte naše recenzije na Googleu</span>
        <span class="underline decoration-brick-600 decoration-2 underline-offset-4" x-cloak x-show="$store.lang.current === 'en'">Read our reviews on Google</span>
      </a>
    </div>

    <div
      class="reveal reveal-delay-1 mt-14"
      x-intersect.once="$el.classList.add('is-visible')"
      x-data={`{
        active: 1,
        paused: false,
        moving: true,
        total: ${slides.length},
        next() { this.moving = true; this.active++ },
        prev() { this.moving = true; this.active-- },
        settle() {
          if (this.active === 0) {
            this.moving = false;
            this.active = this.total;
            requestAnimationFrame(() => requestAnimationFrame(() => { this.moving = true }));
          }
          if (this.active === this.total + 1) {
            this.moving = false;
            this.active = 1;
            requestAnimationFrame(() => requestAnimationFrame(() => { this.moving = true }));
          }
        }
      }`}
      x-init={`setInterval(() => { if (!paused) next() }, 9500)`}
    >
      {/* Mobile: single-card swipeable carousel */}
      <div
        class="md:hidden"
        x-data={`{
          mActive: 1,
          mPaused: false,
          mMoving: true,
          mTotal: ${reviews.length},
          _tx: 0,
          mNext() { this.mMoving = true; this.mActive++ },
          mPrev() { this.mMoving = true; this.mActive-- },
          mSettle() {
            if (this.mActive === 0) {
              this.mMoving = false;
              this.mActive = this.mTotal;
              requestAnimationFrame(() => requestAnimationFrame(() => { this.mMoving = true }));
            }
            if (this.mActive === this.mTotal + 1) {
              this.mMoving = false;
              this.mActive = 1;
              requestAnimationFrame(() => requestAnimationFrame(() => { this.mMoving = true }));
            }
          }
        }`}
        x-init={`setInterval(() => { if (!mPaused) mNext() }, 9500)`}
      >
        <div class="overflow-hidden" @mouseenter="mPaused = true" @mouseleave="mPaused = false">
          <div
            class="flex ease-out"
            :class="mMoving ? 'transition-transform duration-[1200ms]' : 'transition-none'"
            :style="`transform: translateX(-${mActive * 100}%)`"
            @transitionend="mSettle()"
          >
            {
              mobileSlides.map((review) => (
                <div
                  class="min-w-full"
                  @touchstart.passive="_tx = $event.touches[0].clientX"
                  @touchend.passive="let dx = $event.changedTouches[0].clientX - _tx; if (Math.abs(dx) > 40) dx < 0 ? mNext() : mPrev()"
                >
                  <article class="relative mx-auto flex min-h-[22rem] w-full max-w-3xl flex-col overflow-hidden bg-sea-950 p-7 pb-24 shadow-[0_26px_70px_rgba(8,40,58,0.24),0_1px_0_rgba(255,255,255,0.08)_inset] sm:p-8 sm:pb-24">
                    <p class={`relative max-w-[38rem] flex-1 tracking-[0.02em] text-gray-100 ${reviewClass(review)}`}>
                      <span x-text={`$store.lang.current === 'hr' ? ${JSON.stringify(`“${review.textHr}”`)} : ${JSON.stringify(`“${review.textEn}”`)}`}>
                        &ldquo;{review.textHr}&rdquo;
                      </span>
                    </p>
                    <div class="absolute inset-x-7 bottom-7 flex items-end justify-between gap-6 sm:inset-x-8 sm:bottom-8">
                      <p class="text-base font-bold text-white">{review.name}</p>
                      <div class="pointer-events-none absolute bottom-0 right-0 translate-y-[30px] font-heading text-[5rem] leading-[0.5] text-sea-800/80" aria-hidden="true">&rdquo;</div>
                    </div>
                  </article>
                </div>
              ))
            }
          </div>
        </div>
        <div class="mt-7 flex items-center justify-center gap-3">
          <button
            type="button"
            class="inline-flex h-12 w-12 items-center justify-center bg-brick-600 text-white shadow-[0_14px_35px_rgba(166,52,42,0.22)] transition hover:bg-brick-700"
            aria-label="Prethodna recenzija"
            @click="mPrev()"
          >
            <ChevronLeft class="h-5 w-5" />
          </button>
          <button
            type="button"
            class="inline-flex h-12 w-12 items-center justify-center bg-brick-600 text-white shadow-[0_14px_35px_rgba(166,52,42,0.22)] transition hover:bg-brick-700"
            aria-label="Sljedeća recenzija"
            @click="mNext()"
          >
            <ChevronRight class="h-5 w-5" />
          </button>
        </div>
      </div>

      {/* Desktop: 2-up grouped carousel */}
      <div class="hidden overflow-hidden md:block" @mouseenter="paused = true" @mouseleave="paused = false">
        <div
          class="flex ease-out"
          :class="moving ? 'transition-transform duration-[1200ms]' : 'transition-none'"
          :style="`transform: translateX(-${active * 100}%)`"
          @transitionend="settle()"
        >
          {
            desktopSlides.map((slide) => (
                <div class="grid min-w-full grid-cols-2 gap-8">
                {slide.map((review) => (
                  <article class="relative flex min-h-[21rem] flex-col overflow-hidden bg-sea-950 p-9 pb-28 shadow-[0_28px_80px_rgba(8,40,58,0.22),0_1px_0_rgba(255,255,255,0.08)_inset] lg:p-12 lg:pb-32">
                    <p class={`relative max-w-[40rem] flex-1 tracking-[0.02em] text-gray-100 ${reviewClass(review)}`}>
                      <span x-text={`$store.lang.current === 'hr' ? ${JSON.stringify(`“${review.textHr}”`)} : ${JSON.stringify(`“${review.textEn}”`)}`}>
                        &ldquo;{review.textHr}&rdquo;
                      </span>
                    </p>
                    <div class="absolute inset-x-9 bottom-9 flex items-end justify-between gap-6 lg:inset-x-12 lg:bottom-12">
                      <p class="text-lg font-bold text-white">{review.name}</p>
                      <div class="pointer-events-none absolute bottom-0 right-0 translate-y-[60px] font-heading text-[7rem] leading-[0.5] text-sea-800/80 lg:text-[8rem]" aria-hidden="true">&rdquo;</div>
                    </div>
                  </article>
                ))}
              </div>
            ))
          }
        </div>
      </div>

      <div class="mt-10 hidden items-center justify-center gap-6 md:flex">
        <div class="flex items-center gap-3">
          <button
            type="button"
            class="inline-flex h-12 w-12 items-center justify-center bg-brick-600 text-white shadow-[0_14px_35px_rgba(166,52,42,0.22)] transition hover:bg-brick-700"
            aria-label="Prethodne recenzije"
            @click="prev()"
          >
            <ChevronLeft class="h-5 w-5" />
          </button>
          <button
            type="button"
            class="inline-flex h-12 w-12 items-center justify-center bg-brick-600 text-white shadow-[0_14px_35px_rgba(166,52,42,0.22)] transition hover:bg-brick-700"
            aria-label="Sljedeće recenzije"
            @click="next()"
          >
            <ChevronRight class="h-5 w-5" />
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
