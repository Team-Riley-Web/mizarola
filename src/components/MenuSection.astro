---
import { Image } from 'astro:assets';
import { icons } from '@lucide/astro';
import { menu } from '../data/menu';
import barrels from '../assets/images/barrels.png';
import croatiaShield from '../assets/images/croatia-shield.png';
import donkey from '../assets/images/donkey2.png';
import oliveBranch from '../assets/images/olive-branch.png';
---

<section id="jelovnik" class="relative scroll-mt-20 overflow-hidden bg-[linear-gradient(180deg,#111c27_0%,#08283a_52%,#0d3b52_100%)] pt-20 md:pt-28">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <Image
      src={oliveBranch}
      alt=""
      class="absolute left-[calc(var(--spacing)*-2)] top-[8rem] hidden w-64 -rotate-[18deg] opacity-[0.07] md:block md:w-96"
      style="scale: 1.02;"
      data-scroll-scale-image
      data-scroll-scale-base="1.02"
      data-scroll-scale-amount="0.06"
      widths={[256, 384, 512]}
      sizes="(min-width: 768px) 24rem, 16rem"
    />
    <Image
      src={oliveBranch}
      alt=""
      class="absolute -bottom-12 -right-28 hidden w-72 -scale-x-100 -scale-y-100 rotate-[180deg] opacity-[0.07] md:bottom-[calc(var(--spacing)*4)] md:-right-20 md:block md:w-[28rem]"
      style="scale: 1.02;"
      data-scroll-scale-image
      data-scroll-scale-base="1.02"
      data-scroll-scale-amount="0.06"
      widths={[288, 448, 640]}
      sizes="(min-width: 768px) 28rem, 18rem"
    />
    <Image
      src={barrels}
      alt=""
      class="absolute right-[-7rem] top-1/4 hidden w-72 -translate-y-1/2 rotate-[8deg] opacity-10 brightness-0 invert lg:block xl:right-[-4rem] xl:w-96"
      widths={[288, 384, 520]}
      sizes="(min-width: 1280px) 24rem, 18rem"
      aria-hidden="true"
    />
    <Image
      src={donkey}
      alt=""
      class="absolute left-[-8rem] top-3/4 hidden w-72 -translate-y-1/2 -rotate-[7deg] opacity-10 brightness-0 invert lg:block xl:left-[-5rem] xl:w-96"
      widths={[288, 384, 520]}
      sizes="(min-width: 1280px) 24rem, 18rem"
      aria-hidden="true"
    />
  </div>

  <div class="relative mx-auto max-w-6xl px-6 md:px-8">
    <div class="reveal flex flex-col items-center text-center" x-intersect.once="$el.classList.add('is-visible')">
      <Image
        src={croatiaShield}
        alt="Hrvatski grb"
        width={110}
        height={145}
        class="mb-7 h-24 w-auto shrink-0 drop-shadow-md md:h-28"
        style="scale: 1;"
        data-scroll-scale-image
        data-scroll-scale-base="1"
        data-scroll-scale-amount="0.06"
      />

      <div class="max-w-2xl">
        <p class="mb-3 text-lg font-normal tracking-[0.03em] text-gray-100">Jelovnik &middot; Menu</p>
        <h2 class="font-heading text-4xl font-normal text-white text-[clamp(2.5rem,5vw,4rem)]">
          <span x-show="$store.lang.current === 'hr'">Što Nudimo</span>
          <span x-cloak x-show="$store.lang.current === 'en'">What We Serve</span>
        </h2>
        <p class="mt-4 text-lg leading-[1.5] tracking-[0.03em] text-gray-100" x-show="$store.lang.current === 'hr'">
          Sve cijene su u eurima. Za pića i vinsku kartu pitajte konobara.
        </p>
        <p class="mt-4 text-lg leading-[1.5] tracking-[0.03em] text-gray-100" x-cloak x-show="$store.lang.current === 'en'">
          All prices are in euros. Ask your server for our drinks and wine list.
        </p>
      </div>
    </div>

    <nav class="reveal reveal-delay-1 mt-10 flex flex-wrap justify-center gap-2 lg:max-w-3xl lg:mx-auto" aria-label="Kategorije jelovnika" x-intersect.once="$el.classList.add('is-visible')">
      {
        menu.map((category) => (
          <a
            href={`#${category.id}`}
            class="rounded-full border border-gray-500 bg-gray-800 px-4 py-2 text-base font-semibold uppercase tracking-[0.03em] text-gray-100 transition hover:border-gray-200 hover:bg-gray-700 hover:text-white"
          >
            <span x-show="$store.lang.current === 'hr'">{category.hr}</span>
            <span x-cloak x-show="$store.lang.current === 'en'">{category.en}</span>
          </a>
        ))
      }
    </nav>

    <div class="mt-24 space-y-24 md:mt-28 md:space-y-28">
      {
        menu.map((category) => {
          const Icon = icons[category.icon as keyof typeof icons];

          const items = (
            <ul class="gap-x-10 gap-y-10 md:grid md:grid-cols-2">
              {category.items.map((item) => (
                <li class="pb-8">
                  <div class="flex items-baseline gap-3">
                    <span class="min-w-0 max-w-[72%] font-display text-2xl font-normal leading-tight text-white transition-colors hover:text-gray-100 md:max-w-none">
                      <span x-show="$store.lang.current === 'hr'">{item.hr}</span>
                      <span x-cloak x-show="$store.lang.current === 'en'">{item.en}</span>
                    </span>
                    <span class="mb-1 min-w-8 flex-1 border-b border-dotted border-gray-500" aria-hidden="true"></span>
                    <span class="shrink-0 font-display text-3xl font-normal text-gray-100">{item.price} &euro;</span>
                  </div>
                  {(item.noteHr || item.noteEn) && (
                    <p class="mt-1 text-base leading-[1.5] tracking-[0.03em] text-gray-100">
                      {item.noteHr && <span x-show="$store.lang.current === 'hr'">{item.noteHr}</span>}
                      {item.noteEn && <span x-cloak x-show="$store.lang.current === 'en'">{item.noteEn}</span>}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          );

          return (
            <div id={category.id} class="reveal mx-auto max-w-4xl scroll-mt-24" x-intersect.once="$el.classList.add('is-visible')">
              <div class="mb-7 flex items-center gap-3 border-b-2 border-gray-500 pb-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gray-700 text-gray-100">
                  <Icon class="h-4.5 w-4.5" />
                </span>
                <h3 class="font-heading text-3xl font-normal text-white transition-colors hover:text-gray-100">
                  <span x-show="$store.lang.current === 'hr'">{category.hr}</span>
                  <span x-cloak x-show="$store.lang.current === 'en'">{category.en}</span>
                </h3>
              </div>

              {items}
            </div>
          );
        })
      }
    </div>
  </div>
</section>
