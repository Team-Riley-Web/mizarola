---
import '../styles/global.css';
import barrelDark from '../assets/images/barrel-dark.png';
import barrelWhite from '../assets/images/barrel-white.png';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title = 'Konoba Mizarola — Sućuraj, Hvar',
  description = 'Konoba Mizarola u Sućurju na otoku Hvaru: svježa riba, plodovi mora, roštilj i pizza uz pogled na more. / A family konoba in Sućuraj, Hvar serving fresh fish, seafood, grill and pizza by the sea.',
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const socialShareUrl = new URL('/social-share.png', siteUrl).toString();
const socialShareAlt = 'Konoba Mizarola by the harbour in Sućuraj, Hvar';
---

<!doctype html>
<html lang="hr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" media="(prefers-color-scheme: light)" href={barrelDark.src} />
    <link rel="icon" type="image/png" media="(prefers-color-scheme: dark)" href={barrelWhite.src} />
    <link rel="icon" type="image/png" href={barrelDark.src} />
    <link rel="apple-touch-icon" href={barrelDark.src} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>

    <meta property="og:site_name" content="Konoba Mizarola" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="hr_HR" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialShareUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1000" />
    <meta property="og:image:height" content="600" />
    <meta property="og:image:alt" content={socialShareAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialShareUrl} />
    <meta name="twitter:image:alt" content={socialShareAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Jost:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class=""
    x-data="{
      updateScrollScaleImages() {
        const viewportHeight = window.innerHeight;

        document.querySelectorAll('[data-scroll-scale-image]').forEach((image) => {
          const frame = image.parentElement;
          const rect = frame.getBoundingClientRect();

          if (rect.bottom < 0 || rect.top > viewportHeight) return;

          const progress = Math.min(1, Math.max(0, (viewportHeight - rect.top) / (viewportHeight + rect.height)));
          const base = Number.parseFloat(image.dataset.scrollScaleBase || '1.04');
          const amount = Number.parseFloat(image.dataset.scrollScaleAmount || '0.16');
          const scale = base + progress * amount;

          image.style.scale = scale.toString();
        });
      }
    }"
    x-init="
      updateScrollScaleImages();
      window.addEventListener('scroll', () => requestAnimationFrame(() => updateScrollScaleImages()), { passive: true });
      window.addEventListener('resize', () => requestAnimationFrame(() => updateScrollScaleImages()), { passive: true });
    "
  >
    <slot />
  </body>
</html>
